# Copia este archivo como .env.local y completa los valores. .env.local nunca se sube a git.

# Dominio público de la clínica (sin barra final). Se usa en canonical, sitemap y datos estructurados.
NEXT_PUBLIC_SITE_URL=https://clinica.anacure.co

# Sitio hermano del spa, para los enlaces de recuperación.
NEXT_PUBLIC_SPA_URL=https://anacure.agenda.nodbu.com

# Analítica (Plausible autoalojado). Déjalo vacío hasta que el servidor esté listo.
# Ejemplo: NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.nodbu.com
NEXT_PUBLIC_PLAUSIBLE_HOST=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=clinica.anacure.co
